rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site_content/{contentId} {
      allow read, write: if true;
    }

    match /uploaded_images/{imageId} {
      allow read, write: if true;
    }

    match /books/{bookId} {
      allow read, write: if true;
    }

    match /comments/{commentId} {
      allow read, write: if true;
    }

    match /photos_gallery/{photoId} {
      allow read, write: if true;
    }

    match /community_posts/{postId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /push_subscriptions/{subId} {
      allow read, write: if true;
    }

    match /push_config/{configId} {
      allow read, write: if true;
    }

    match /push_history/{tagId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}


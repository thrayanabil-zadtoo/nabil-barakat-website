rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site_content/{contentId} {
      allow read, write: if true;
    }

    match /uploaded_images/{imageId} {
      allow read, write: if true;
    }

    match /books/{bookId} {
      allow read, write: if true;
    }

    match /comments/{commentId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}


{
  "entities": {
    "SiteProfile": {
      "title": "SiteProfile",
      "description": "Author profile details, bio, and banners",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "bio": { "type": "string" },
        "portraitImage": { "type": "string" },
        "headerBannerImage": { "type": "string" },
        "email": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "title"]
    },
    "Book": {
      "title": "Book",
      "description": "Literary book or publication by the author",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "coverImage": { "type": "string" },
        "description": { "type": "string" },
        "publicationYear": { "type": "string" },
        "genre": { "type": "string" },
        "order": { "type": "number" },
        "isPinned": { "type": "boolean" },
        "visibility": {
          "type": "string",
          "enum": ["public", "cover_only", "hidden"],
          "description": "Controls whether book is public, cover-only coming soon, or hidden from visitors"
        }
      },
      "required": ["id", "title"]
    },
    "MediaItem": {
      "title": "MediaItem",
      "description": "Video or photo gallery item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "caption": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "position": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "number" },
        "likesCount": { "type": "number" },
        "viewsCount": { "type": "number" },
        "isPinned": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "VisitorComment": {
      "title": "VisitorComment",
      "description": "Comments left by visitors or readers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderName": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "status": { "type": "string" }
      },
      "required": ["id", "senderName", "content"]
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "Comprehensive synchronized website content document",
      "type": "object",
      "properties": {
        "authorProfile": { "type": "object" },
        "books": { "type": "array" },
        "videos": { "type": "array" },
        "photos": { "type": "array" },
        "news": { "type": "array" },
        "links": { "type": "array" },
        "announcements": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["updatedAt"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Poems, thoughts, and literary community posts by the author",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "title": { "type": "string" },
        "bgColor": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "audioUrl": { "type": "string" },
        "audioDuration": { "type": "string" },
        "linkUrl": { "type": "string" },
        "linkText": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "number" },
        "viewsCount": { "type": "number" },
        "likesCount": { "type": "number" },
        "isPinned": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "content"]
    },
    "PushSubscription": {
      "title": "PushSubscription",
      "description": "Web Push browser/PWA device subscription for background notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "endpoint": { "type": "string" },
        "p256dh": { "type": "string" },
        "auth": { "type": "string" },
        "expirationTime": { "type": "number" },
        "isStandalone": { "type": "boolean" },
        "userAgent": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "endpoint", "p256dh", "auth"]
    },
    "PushConfig": {
      "title": "PushConfig",
      "description": "Public Web Push VAPID key configuration",
      "type": "object",
      "properties": {
        "publicKey": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["publicKey"]
    }
  },
  "firestore": {
    "/site_content/{contentId}": {
      "schema": "SiteContent",
      "description": "Full synchronized website content and updates"
    },
    "/photos_gallery/{photoId}": {
      "schema": "MediaItem",
      "description": "Individual gallery photos and media snapshots"
    },
    "/community_posts/{postId}": {
      "schema": "CommunityPost",
      "description": "Individual community posts and poems collection"
    },
    "/books/{bookId}": {
      "schema": "Book",
      "description": "Collection of author books"
    },
    "/comments/{commentId}": {
      "schema": "VisitorComment",
      "description": "Public comments and reviews"
    },
    "/push_subscriptions/{subId}": {
      "schema": "PushSubscription",
      "description": "Registered PWA Web Push device endpoints for background notifications"
    },
    "/push_config/{configId}": {
      "schema": "PushConfig",
      "description": "Public VAPID key configuration for Web Push subscriptions"
    }
  }
}
